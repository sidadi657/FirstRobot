<?xml version="1.0"?>
<robot name="forros" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>


    <joint name="motor_house_left_front">
      <command_interface name="position">
        <param name="min">-1.5708</param>
        <param name="max">1.5708</param>
      </command_interface>
      <state_interface name="position" />
    </joint>

    <joint name="motor_house_right_front">
      <command_interface name="position">
        <param name="min">-1.5708</param>
        <param name="max">1.5708</param>
      </command_interface>
      <state_interface name="position" />
    </joint>

    <joint name="motor_house_left_back">
      <command_interface name="position">
        <param name="min">-1.5708</param>
        <param name="max">1.5708</param>
      </command_interface>
      <state_interface name="position" />
    </joint>

    <joint name="motor_house_right_back">
      <command_interface name="position">
        <param name="min">-1.5708</param>
        <param name="max">1.5708</param>
      </command_interface>
      <state_interface name="position" />
    </joint>

    <joint name="left_front_wheel">
      <command_interface name="velocity" />
      <state_interface name="velocity" />
      <state_interface name="position" />
    </joint>

    <joint name="right_front_wheel">
      <command_interface name="velocity" />
      <state_interface name="velocity" />
      <state_interface name="position" />
    </joint>
    <joint name="left_back_wheel">
      <command_interface name="velocity" />
      <state_interface name="velocity" />
      <state_interface name="position" />
    </joint>
    <joint name="right_back_wheel">
      <command_interface name="velocity" />
      <state_interface name="velocity" />
      <state_interface name="position" />
    </joint>

    <joint name="left_mid_wheel">
      <command_interface name="velocity" />
      <state_interface name="velocity" />
      <state_interface name="position" />
    </joint>
    <joint name="right_mid_wheel">
      <command_interface name="velocity" />
      <state_interface name="velocity" />
      <state_interface name="position" />
    </joint>

    <joint name="left_rocker_arm">
      <state_interface name="position" />
    </joint>
    <joint name="right_rocker_arm">
      <state_interface name="position" />
    </joint>
    <joint name="left_rocker_bogie">  <!-- use your actual joint name -->
      <state_interface name="position" />
    </joint>
    <joint name="right_rocker_bogie">  <!-- use your actual joint name -->
      <state_interface name="position" />
    </joint>

  </ros2_control>
</robot>