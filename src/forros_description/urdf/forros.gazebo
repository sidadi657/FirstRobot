<?xml version="1.0"?>
<robot name="forros" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="body_color" value="Gazebo/Silver" />

  <gazebo reference="base_link">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    <gravity>true</gravity>
  </gazebo>

  <gazebo reference="right_mid_wheel_1">
    <material>${body_color}</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="left_mid_wheel_1">
    <material>${body_color}</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="BogieArm_left_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="motor_house_left_mid_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="BogieArm_right_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="right_back_wheel_1">
    <material>${body_color}</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="right_front_wheel_1">
    <material>${body_color}</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="left_back_wheel_1">
    <material>${body_color}</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="left_front_wheel_1">
    <material>${body_color}</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="motor_house_right_mid_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="motor_house_left_front_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="motor_house_right_front_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="motor_house_right_back_2">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="motor_house_left_back_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="RockerArm_left_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="RockerArm_right_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>2</dimensions>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
    </plugin>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar_link" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <frame_id>lidar_link</frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>500</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>12.0</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.03</stddev>
        </noise>
      </ray>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>


  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find forros_description)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>


</robot>