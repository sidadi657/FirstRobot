<?xml version="1.0"?>
<sdf version="1.8">
  <world name="default">

    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1000</real_time_factor>
      <dart>
        <solver>
          <type>dantzig</type>
        </solver>
      </dart>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />

    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Custom Blender Terrain -->
    <model name="terrain">
      <static>true</static>
      <pose>0 1 0 1.5708 0 0</pose>
      <link name="link">

        <!-- PHYSICS: Uses the ultra-fast decimated STL -->
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://rover_description/meshes/test.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>10</mu>
                <mu2>10</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <!-- VISUALS: Uses your high-poly STL for beautiful curves -->
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://rover_description/meshes/test.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <color rgba="1 0.0 0.0 1.0"/>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>